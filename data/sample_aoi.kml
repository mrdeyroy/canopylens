<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample Forest Area of Interest (AOI)</name>
    <description>Boundary polygon for forest canopy analysis demonstration at OSBS study site.</description>
    <Placemark>
      <name>Study Plot A</name>
      <description>Ordway-Swisher Forest Plot Boundary</description>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              -81.9940,29.6880,0
              -81.9910,29.6880,0
              -81.9910,29.6910,0
              -81.9940,29.6910,0
              -81.9940,29.6880,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
  </Document>
</kml>
